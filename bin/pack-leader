#!/bin/sh
# pack-leader: the orchestration CLI. Resolves its real location so a symlink in PATH works.
self="$0"
while [ -L "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
bin="$root/zig-out/bin/pack-leader"
# Build on first use, and again whenever a source file is newer than the binary.
if [ ! -x "$bin" ] || [ -n "$(find "$root/zig" "$root/build.zig" -newer "$bin" -name '*.zig' 2>/dev/null | head -n 1)" ]; then
  command -v zig >/dev/null 2>&1 || { echo "pack-leader: $bin is missing or stale and zig 0.17 is not on PATH; install zig, then run \`zig build -Drelease\` in $root" >&2; exit 127; }
  (cd "$root" && zig build -Drelease >&2) || { echo "pack-leader: building the binary failed; run \`zig build -Drelease\` in $root" >&2; exit 1; }
fi
exec "$bin" "$@"
